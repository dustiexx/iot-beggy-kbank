# copy to .env and fill in (never commit .env)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite   # thinking + tools (comma list = fallbacks; 3.6/3.8 flash are only 20 requests/day)
# GEMINI_STT_MODEL=gemini-3.1-flash-lite   # speech to text

# MQTT: local Mosquitto for development
MQTT_HOST=localhost
MQTT_PORT=1883
# AWS IoT Core (when the thing is created): endpoint from IoT Core > Settings, certs in raspi/certs/ (gitignored)
# MQTT_HOST=xxxxxxxxxxxxxx-ats.iot.ap-southeast-1.amazonaws.com
# MQTT_PORT=8883
# MQTT_CA=certs/AmazonRootCA1.pem
# MQTT_CERT=certs/beggy-pi.cert.pem
# MQTT_KEY=certs/beggy-pi.private.key
# MQTT_RETAIN=false   # set false if the AWS policy has no iot:RetainPublish (retained will/publish gets the connection dropped)
MQTT_CLIENT_ID=beggy-pi

# hardware
CAMERA_SOURCE=picam          # or 8 for the USB webcam
HEAD_DRIVER=fake             # hwpwm when the servos are wired (needs the pwm-2chan overlay), sim to test with a webcam
AUDIO_OUT=none               # plughw:CARD=MAX98357A,DEV=0 for the I2S amp; none = save replies to tts_out/
AUDIO_GAIN_DB=0              # louder TTS playback through a soft limiter, e.g. 8 for the MAX98357A
MIC_DEVICE=DGM20             # part of the mic name from `voice_main.py devices` (ours: USB PnP Sound Device)
WAKE_MODE=wake               # off = only POST /ask
API_PORT=8080

# backend (history questions: "how long did I slouch today?") - API contract at the top of beggy/history.py
# BACKEND_URL=https://xxxx.execute-api.ap-southeast-1.amazonaws.com
# BACKEND_KEY=
